{
  "name": "mesh-dark",
  "version": "1.0.0",
  "private": true,
  "description": "Тёмная тема для school.mos.ru (расширение Firefox).",
  "license": "MIT",
  "homepage": "https://github.com/Op1xx/MESH.dark",
  "repository": {
    "type": "git",
    "url": "https://github.com/Op1xx/MESH.dark.git"
  },
  "bugs": {
    "url": "https://github.com/Op1xx/MESH.dark/issues"
  },
  "scripts": {
    "build": "bash build.sh",
    "lint": "web-ext lint --source-dir .",
    "start": "web-ext run --source-dir . --target firefox",
    "start:android": "web-ext run --source-dir . --target firefox-android",
    "sign": "web-ext sign --source-dir . --channel unlisted",
    "pack": "npm run build && npm run lint"
  },
  "devDependencies": {
    "web-ext": "^8.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
